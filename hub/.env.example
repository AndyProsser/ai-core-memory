# Copy to .env (never commit .env). Generate a key with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MEMORY_HUB_SECRET_KEY=
# The URL people (and your OIDC provider) use to reach the hub. Used for the OIDC redirect URI.
MEMORY_HUB_PUBLIC_URL=http://localhost:8000
MEMORY_HUB_ADMIN_EMAIL=
# MEMORY_HUB_BIND=127.0.0.1
# MEMORY_HUB_PORT=8000
# MEMORY_HUB_TRUST_PROXY=false
# Hours between automatic consolidation passes (0 = off; `acm consolidate` still works)
# MEMORY_HUB_CONSOLIDATE_INTERVAL_HOURS=24

# Plugin secrets: the Plugins screen asks for the *name* of an environment variable; define its value here.
# SLACK_WEBHOOK_URL=slack://tokenA/tokenB/tokenC/   (an Apprise URL — see https://github.com/caronc/apprise)
# MEMOS_TOKEN=
# MEMORY_HUB_PLUGINS=true   (false switches every plugin off)

# Optional SSO (OpenID Connect). Redirect URI to register: <MEMORY_HUB_PUBLIC_URL>/auth/oidc/callback
# MEMORY_HUB_OIDC_ISSUER=https://accounts.example.com
# MEMORY_HUB_OIDC_CLIENT_ID=
# MEMORY_HUB_OIDC_CLIENT_SECRET=
